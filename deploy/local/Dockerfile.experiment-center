# Build context: repo root
FROM docker.m.daocloud.io/oven/bun:1.4.4
WORKDIR /work
COPY services/experiment-center ./services/experiment-center
WORKDIR /work/services/experiment-center
RUN bun install --production --registry https://registry.npmmirror.com
ENV NODE_ENV=development HOST=0.0.0.0 PORT=4108
EXPOSE 4108
HEALTHCHECK --interval=10s --timeout=5s --retries=12 \
  CMD bun -e "fetch('http://127.0.0.1:4108/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["bun", "src/server.ts"]
