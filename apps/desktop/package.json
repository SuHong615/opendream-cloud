{
  "name": "opendream-code-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OpenDream Code desktop local engine (Electron)",
  "main": "main.cjs",
  "author": "suhong",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "cloud.opendream.code",
    "productName": "OpenDream Code",
    "files": ["main.cjs", "preload.cjs", "engine.cjs", "renderer/**"],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "artifactName": "OpenDreamCode-Setup-${version}.${ext}"
    }
  }
}
