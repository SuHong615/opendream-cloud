{
    "name":  "opendream-cloud",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "packageManager":  "bun@1.4.3",
    "workspaces":  [
                       "apps/console",
                       "apps/control-plane",
                       "services/*",
                       "packages/*"
                   ],
    "engines":  {
                    "bun":  "\u003e=1.4.0",
                    "node":  "\u003e=22"
                },
    "scripts":  {
                    "dev":  "bun run scripts/dev.ts",
                    "dev:check":  "bun run scripts/dev.ts --check",
                    "smoke:dev":  "bun run scripts/smoke-dev.ts",
                    "smoke:api":  "bun run scripts/smoke-api.ts",
                    "test":  "bun run scripts/test.ts",
                    "test:all":  "bun run scripts/test.ts --all",
                    "test:watch":  "bun run scripts/test.ts --watch",
                    "build":  "bun run scripts/build.ts",
                    "lint":  "tsc --noEmit -p tsconfig.json \u0026\u0026 bun run scripts/validate-manifests.mjs \u0026\u0026 bun run check:ports \u0026\u0026 bun run validate:workflow",
                    "typecheck":  "tsc --noEmit -p tsconfig.json",
                    "validate:manifests":  "bun run scripts/validate-manifests.mjs",
                    "check:ports":  "bun run scripts/verify/check-port-4200.mjs",
                    "validate:workflow":  "bun run --cwd packages/schema validate",
                    "clean":  "bun run scripts/clean.ts",
                    "check:license":  "bun run scripts/check-license.mjs"
                },
    "dependencies":  {
                         "@kubernetes/client-node":  "^0.22.3",
                         "drizzle-orm":  "^0.38.3",
                         "fastify":  "^5.2.0",
                         "zod":  "^3.24.1"
                     },
    "devDependencies":  {
                            "@playwright/test":  "1.60.0",
                            "@types/bun":  "^1.1.14",
                            "@types/node":  "^22.10.2",
                            "typescript":  "^5.7.2"
                        },
    "license":  "Apache-2.0",
    "author":  "suhong",
    "contributors":  [
                         "suhong"
                     ]
}

