  classDef cp fill:#ecfeff,stroke:#0891b2,color:#164e63,stroke-width:1.2px
  classDef core fill:#fef2f2,stroke:#dc2626,color:#7f1d1d,stroke-width:1.8px
  classDef dp fill:#f0fdf4,stroke:#16a34a,color:#14532d,stroke-width:1.2px
  classDef rt fill:#fff7ed,stroke:#ea580c,color:#7c2d12,stroke-width:1.2px
  classDef biz fill:#fdf2f8,stroke:#db2777,color:#831843,stroke-width:1.2px
  classDef ext fill:#f3f4f6,stroke:#6b7280,color:#111827,stroke-width:1px

