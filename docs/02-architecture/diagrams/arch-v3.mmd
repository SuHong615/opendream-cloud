flowchart TB
  U["用户 / IM（钉钉·飞书·企微） / 企业系统"] --> GW

  subgraph L0["L0 统一 AI 网关（Higress 默认 / agentgateway 可选）"]
    GW["TLS·WAF · OIDC/APIKey · 租户路由 · 模型路由 · MCP 入口 · 限流/缓存 · 审计/Trace"]
  end

  GW --> MCPGW
  GW --> MODELGW
  GW --> APPGW

  subgraph L1["L1 控制面（Control Plane）"]
    IDP["Identity / Tenant / RBAC"]
    REG["MCP Registry：生命周期·版本·审核·签名"]
    POL["MCP Policy：工具级 allow/deny·配额"]
    MC["Model Center：企业/第三方模型·Key 加密"]
    AC["App Center：权限·分享·协同会话"]
    WF["Workflow Engine：SDLC / 通用模板"]
    DH["Digital Human Control：形象·音色·RTC"]
    OBS["Audit / Usage / Billing / Watchdog"]
  end

  subgraph L2["L2 数据面（Data Plane）"]
    MCPGW["MCP Gateway：协议适配 HTTP/SSE/stdio · 凭证注入 · 工具级 PEP · 熔断 · 缓存"]
    MODELGW["Model Gateway：LiteLLM / 企业模型统一出口 · 虚拟 Key · 成本"]
    APPGW["App / Workspace Ingress：应用路由 · 工作区票据"]
  end

  subgraph L3["L3 执行层（Runtime）"]
    WS["opencode Workspace（4C8G · PVC · Agent/Skill/MCP）"]
    APP["App Runtime（1C2G · Web/Agent 应用）"]
    WFW["Workflow Worker（持久化·人工任务·定时器）"]
    DHR["Digital Human Runtime（ASR/TTS/口型/RTC/GPU）"]
  end

  subgraph L4["L4 业务层（Business）"]
    APPS["应用中心：Web / Agent / 数字人 / 工作流 应用"]
    SDLC["SDLC 工作流：需求→设计→开发→测试→发布→运维"]
    GEN["通用工作流：客服 / 审批 / 数据 / 运维 / 接待"]
    DHAPI["数字人对外 API / SDK / iframe"]
  end

  MCPGW --> EXT["企业 MCP Server / 内部 API / SaaS / 数据库"]
  MODELGW --> MODELS["企业模型网关 / 第三方模型（OpenAI·DeepSeek·通义·Kimi…）"]

  REG -. 发布/版本/健康 .-> MCPGW
  POL -. 工具策略/限流 .-> MCPGW
  IDP -. 身份/票据 .-> GW
  MC -. 配置下发 .-> WS
  AC -. 会话/提案/审批 .-> WS
  WF -. 任务/事件 .-> WFW
  DH -. 资产/编排 .-> DHR
  OBS -. 指标/审计 .-> GW

  APPGW --> WS
  APPGW --> APP
  WS --> APPS
  APP --> APPS
  WFW --> SDLC
  WFW --> GEN
  DHR --> DHAPI
  APPS --> U
  DHAPI --> U

