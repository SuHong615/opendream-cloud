# ===== OpenDream Cloud · 本地开发环境变量（复制为 .env）=====
# 说明：仅本地/dev 使用；staging/prod 由 K8s Secret + ESM/KMS 注入，绝不提交真实密钥。

# --- 控制面（platform-backend）---
DATABASE_URL=file:./.data/control-plane.db
CONTROL_PLANE_PORT=4000
CONTROL_PLANE_BASE_URL=http://localhost:4000
SESSION_HMAC_SECRET=dev-only-change-me-32bytes-minimum
APIKEY_PEPPER=dev-only-change-me-32bytes-minimum
ALLOW_DEV_LOGIN=1
# 企业 SSO：本地默认 mock；生产设置 OIDC_ENABLED=1、OIDC_MOCK=0 并填写企业 IdP
OIDC_ENABLED=1
OIDC_MOCK=1
OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/callback
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=opendream-cloud
# OIDC_CLIENT_SECRET=change-me

# 私有化对象存储（MinIO / S3）：审计/用量导出使用；未配置则内存临时导出
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=opendream
# S3_ACCESS_KEY=opendream
# S3_SECRET_KEY=opendream-minio-change-me
# S3_FORCE_PATH_STYLE=true

# 异步事件总线（NATS JetStream）；未配置时 outbox 本地落库不投递
# NATS_URL=nats://localhost:4222

# Redis（可选）：分布式锁，多副本 outbox publisher/调度去重
# REDIS_URL=redis://localhost:6379

DESTROY_COOLDOWN_MIN=5

# --- 控制台（web-console）---
CONSOLE_PORT=3000
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:4000

# --- 模型网关 / 工作区（infra，G4 测试可 mock）---
LITELLM_BASE_URL=http://localhost:4001
LITELLM_MASTER_KEY=dev-only-change-me
WORKSPACE_AGENT_HEALTH_PORT=8081
OPENCODE_SERVER_PASSWORD=dev-only-workspace-password

# --- 本地编排（kind / 容器）---
# KUBECONFIG=~/.kube/config
# KIND_CLUSTER_NAME=opencode-dev
